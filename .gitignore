# ignore build directory
\build

# ignore object files
*.o

# ignore executable files
*.exe

# ignore asm.sh, other than in the root directory
**/asm.sh
!/asm.sh

# & ignore asm86.sh, other than in the root directory
**/asm86.sh
!/asm86.sh

# & ignore asmmips.sh, other than in the root directory
**/asmmips.sh
!/asmmips.sh

# & ignore runmips.sh, other than in the root directory
**/runmips.sh
!/runmips.sh

# & ignore asm_icx.sh, other than in the root directory
**/asm_icx.sh
!/asm_icx.sh

# ignore zip
*.zip
